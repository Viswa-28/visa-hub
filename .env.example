# SMTP credentials used to email doorstep booking requests.
# Copy to .env.local (never commit .env.local) and restart the server.
#
# Gmail / Google Workspace: host=smtp.gmail.com, port=587, and SMTP_PASS must be
#   an App Password (Google Account > Security > 2-Step Verification > App
#   passwords), not your normal account password.
# Zoho: host=smtp.zoho.in, port=465
# AWS SES: host=email-smtp.<region>.amazonaws.com, port=587, with SES SMTP
#   credentials (these are NOT your AWS access keys).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where booking notifications are delivered.
BOOKING_NOTIFY_EMAIL=

# Optional — defaults to SMTP_USER. Must be an address this SMTP account is
# permitted to send as, or mail will be rejected or marked as spam.
BOOKING_FROM_EMAIL=

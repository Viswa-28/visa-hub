# ---------------------------------------------------------------------------
# Lead delivery. Both forms (contact + doorstep booking) write to BOTH sinks in
# parallel; either one succeeding counts as captured. Leads are also written to
# the server log before delivery is attempted, so nothing is lost outright.
# Copy to .env.local locally, or set in the Vercel dashboard and redeploy.
# ---------------------------------------------------------------------------

# --- Email (SMTP) ---
# Gmail / Google Workspace: host=smtp.gmail.com, port=587, and SMTP_PASS must be
#   an App Password (Google Account > Security > App passwords), NOT your normal
#   account password.
# Zoho: host=smtp.zoho.in, port=465
# AWS SES: host=email-smtp.<region>.amazonaws.com, port=587, SES SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where lead notifications are delivered.
BOOKING_NOTIFY_EMAIL=

# Optional — defaults to SMTP_USER. Must be an address this SMTP account is
# allowed to send as, or mail is rejected or marked as spam.
BOOKING_FROM_EMAIL=

# --- Google Sheet ---
# Apps Script Web App /exec URL. Deploy as "Execute as: Me" and
# "Who has access: Anyone". The script must return {"ok":true} — the server
# checks the body, because Apps Script answers 200 even when the script throws.
GOOGLE_SHEET_WEBHOOK_URL=

# --- Analytics (optional) ---
# Both tags are omitted entirely while unset.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
